# Network Essentials - Git Ignore File

# Package files (regenerated automatically)
*.zip
package-backups/

# Windows security tags
*.Identifier
*.Zone.Identifier

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*~
*.tmp
*.temp
*.swp
*.swo

# Editor files
.vscode/
.idea/
*.sublime-*

# Backup files
*-old.*
*-backup.*
*.bak

# Log files
*.log

# Node modules (if any JS tools used)
node_modules/

# Python cache (if any Python tools used)
__pycache__/
*.pyc

# Test files
test/
tests/
*.test.html

# Archive directory
archive/

# Development notes
TODO.md
NOTES.md
SCRATCHPAD.md

# System files
Thumbs.db
desktop.ini
